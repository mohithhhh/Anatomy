{
  "name": "anatomy",
  "version": "0.1.0",
  "private": true,
  "description": "A free 3D anatomy study app: explore, test yourself, and remember.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "models": "node scripts/fetch-models.mjs",
    "predev": "node scripts/fetch-models.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-models.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "validate:atlas": "node scripts/validate-atlas.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "oxlint": "1.91.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
