{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-unused-vars": "error",
    "import/no-unassigned-import": "off",
    "unicorn/no-array-sort": "off"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  }
}
